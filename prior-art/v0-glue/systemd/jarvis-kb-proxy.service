[Unit]
Description=Jarvis KB Ollama Proxy
After=network.target ollama.service

[Service]
Type=simple
WorkingDirectory=%h/jarvis-kb-bridge
Environment=JARVIS_KB_CONFIG=%h/.config/jarvis-kb/config.yaml
ExecStart=%h/.local/bin/jarvis-kb serve-proxy --port 11436
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
