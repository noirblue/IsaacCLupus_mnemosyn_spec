[Unit]
Description=Jarvis KB MCP Gateway
After=network.target jarvis-kb-proxy.service

[Service]
Type=simple
WorkingDirectory=%h/jarvis-kb-bridge
Environment=JARVIS_KB_CONFIG=%h/.config/jarvis-kb/config.yaml
ExecStart=%h/.local/bin/jarvis-kb serve-mcp
Restart=on-failure
RestartSec=5
StandardInput=socket
StandardOutput=journal

[Install]
WantedBy=default.target
